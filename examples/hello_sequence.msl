# ============================================================
# Script Name: hello_sequence.msl
# Description: A simple, directional, non-conditional sequence
# ============================================================

# Sequence Metadata Headers
@METADATA "sequence_id"    "hello_sequence"
@METADATA "author"         "kevin_jie"
@METADATA "spacecraft"     "MSL"
@METADATA "ground_station" "VS_CODE"

# Directional Sequence
@EPOCH    2026-318T02:15:00.000 START
@RELATIVE 00:00:02.000          COMMAND1
@ABSOLUTE 2026-318T02:16:00.000 COMMAND2 "argument" 123 0.123 true
@RELATIVE 00:00:20.000          COMMAND3 ["argument", true] [123, 0.123]
@RELATIVE 00:02:00.000          COMMAND4 {key1: "argument", key4: true} {key2: 123, key3: 0.123}